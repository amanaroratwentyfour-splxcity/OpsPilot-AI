# Copy this file to .env and fill in real values. .env is git-ignored.

# SQLite file location used by Prisma (see prisma/schema.prisma)
DATABASE_URL="file:./dev.db"

# Optional. Powers AI narrative generation for recommendations (lib/ai/).
# Every recommendation works fully without this set — narratives are a
# strictly optional enrichment layered on top of the deterministic ones.
ANTHROPIC_API_KEY=
