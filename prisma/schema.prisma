// OpsPilot AI — Database Schema
// Represents the operations of one fictional FMCG company: NovaFoods Pvt. Ltd.
// See SYSTEM_ARCHITECTURE.md for the full design rationale.

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum ProductCategory {
  DAIRY
  BEVERAGES
  SNACKS
  BAKERY
  PERSONAL_CARE
  HOUSEHOLD
  FROZEN_FOODS
}

enum ABCClass {
  A
  B
  C
}

enum StockStatus {
  HEALTHY
  LOW
  CRITICAL
  OVERSTOCKED
}

enum PurchaseOrderStatus {
  DRAFT
  SUBMITTED
  APPROVED
  IN_TRANSIT
  RECEIVED
  CANCELLED
}

enum ForecastMethod {
  MOVING_AVERAGE
  EXPONENTIAL_SMOOTHING
}

enum RecommendationCategory {
  INVENTORY
  PROCUREMENT
  SUPPLIER
  DEMAND
}

enum RecommendationSeverity {
  CRITICAL
  WARNING
  INFO
}

enum RecommendationStatus {
  ACTIVE
  ACCEPTED
  DISMISSED
  SNOOZED
}

enum TransactionType {
  PURCHASE
  SALE
  TRANSFER_IN
  TRANSFER_OUT
  RETURN
  ADJUSTMENT
}

// ---------------------------------------------------------------------------
// Models
// ---------------------------------------------------------------------------

model Warehouse {
  id            String @id @default(uuid())
  name          String
  location      String
  capacityUnits Float

  inventory       Inventory[]
  purchaseOrders  PurchaseOrder[]
  recommendations AIRecommendation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Product {
  id            String          @id @default(uuid())
  sku           String          @unique
  name          String
  category      ProductCategory
  unitOfMeasure String
  unitCost      Float
  unitPrice     Float
  leadTimeDays  Int
  perishable    Boolean         @default(false)
  abcClass      ABCClass?

  primarySupplierId String?
  primarySupplier   Supplier? @relation(fields: [primarySupplierId], references: [id], onDelete: SetNull)

  inventory          Inventory[]
  purchaseOrderItems PurchaseOrderItem[]
  demandHistory      DemandHistory[]
  forecasts          Forecast[]
  recommendations    AIRecommendation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
  @@index([primarySupplierId])
}

model Inventory {
  id           String      @id @default(uuid())
  onHandQty    Float
  safetyStock  Float       @default(0)
  reorderPoint Float       @default(0)
  stockStatus  StockStatus @default(HEALTHY)

  lastCalculatedAt DateTime?

  productId   String
  warehouseId String
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  transactions InventoryTransaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, warehouseId])
  @@index([warehouseId])
  @@index([stockStatus])
}

// Immutable audit log of every stock movement against an Inventory row.
// `quantity` is signed: positive for movements that increase on-hand stock
// (PURCHASE, TRANSFER_IN, RETURN), negative for movements that decrease it
// (SALE, TRANSFER_OUT), and either sign for ADJUSTMENT (manual correction).
model InventoryTransaction {
  id              String          @id @default(uuid())
  transactionType TransactionType
  quantity        Float
  reference       String?
  notes           String?

  inventoryId String
  inventory   Inventory @relation(fields: [inventoryId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())

  @@index([inventoryId])
  @@index([transactionType])
}

model Supplier {
  id                     String  @id @default(uuid())
  name                   String
  contactEmail           String?
  contactPhone           String?
  contractedLeadTimeDays Int
  paymentTerms           String?
  reliabilityScore       Float?

  products        Product[]
  purchaseOrders  PurchaseOrder[]
  recommendations AIRecommendation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PurchaseOrder {
  id                   String              @id @default(uuid())
  status               PurchaseOrderStatus @default(DRAFT)
  orderDate            DateTime            @default(now())
  expectedDeliveryDate DateTime?
  actualDeliveryDate   DateTime?

  supplierId  String
  warehouseId String
  supplier    Supplier  @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict)

  items PurchaseOrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([supplierId])
  @@index([warehouseId])
  @@index([status])
}

model PurchaseOrderItem {
  id       String @id @default(uuid())
  quantity Float
  unitCost Float

  purchaseOrderId String
  productId       String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  product         Product       @relation(fields: [productId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())

  @@index([purchaseOrderId])
  @@index([productId])
}

model DemandHistory {
  id           String   @id @default(uuid())
  periodDate   DateTime
  quantitySold Float

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([productId, periodDate])
  @@index([productId])
}

model Forecast {
  id          String         @id @default(uuid())
  method      ForecastMethod
  periodDate  DateTime
  forecastQty Float
  mape        Float?

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([productId, method, periodDate])
  @@index([productId])
}

model AIRecommendation {
  id                  String                 @id @default(uuid())
  category            RecommendationCategory
  severity            RecommendationSeverity
  status              RecommendationStatus   @default(ACTIVE)
  metricJustification String
  aiNarrative         String?

  productId   String?
  supplierId  String?
  warehouseId String?
  product     Product?   @relation(fields: [productId], references: [id], onDelete: SetNull)
  supplier    Supplier?  @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  warehouse   Warehouse? @relation(fields: [warehouseId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, severity])
  @@index([productId])
  @@index([supplierId])
  @@index([warehouseId])
}
